# Development or deployment environment. Copy to .env.local for local use.
DATABASE_URL=
# Set only when ready to index the production domain.
SITE_URL=

# One initial admin account. Generate independent random secrets.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Set test credentials for local checkout. Keep this value at test until launch.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Approved India shipping rule, in paise. Set 0 explicitly for free shipping.
# Variant prices must include applicable taxes before enabling checkout.
INDIA_FLAT_SHIPPING_PAISE=

# Optional. PayPal invoices can be sent directly from the PayPal dashboard.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional. Configure to forward enquiries by email as well as saving in the admin dashboard.
WEB3FORMS_ACCESS_KEY=

# Optional order confirmation email. A verified sender and SITE_URL are required.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
# In Razorpay test mode, receipts go only to this address if explicitly set.
ORDER_EMAIL_TEST_RECIPIENT=
